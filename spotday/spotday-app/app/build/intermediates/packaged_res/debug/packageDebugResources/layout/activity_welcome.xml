<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="Welcome to SpotDay!"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="Let's build your perfect day in San Francisco."
        android:layout_marginBottom="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView android:text="How much time do you have?" />
    <SeekBar
        android:id="@+id/timeSeekBar"
        android:max="8"
        android:progress="4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView android:id="@+id/timeValue" android:text="4 hours" />

    <TextView android:text="What's your total budget?" />
    <SeekBar
        android:id="@+id/budgetSeekBar"
        android:max="200"
        android:progress="50"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView android:id="@+id/budgetValue" android:text="$50" />

    <TextView android:text="Your familiarity:" />
    <RadioGroup
        android:id="@+id/familiarityGroup"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <RadioButton android:id="@+id/tourist" android:text="Tourist"/>
        <RadioButton android:id="@+id/newExplorer" android:text="New"/>
        <RadioButton android:id="@+id/local" android:text="Local"/>
    </RadioGroup>

    <TextView android:text="Must-haves:" />
    <CheckBox android:id="@+id/foodCheck" android:text="Food"/>
    <CheckBox android:id="@+id/activitiesCheck" android:text="Activities"/>

    <Button
        android:id="@+id/startButton"
        android:text="Apply"
        android:layout_marginTop="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout> 